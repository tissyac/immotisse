# Backend configuration
PORT=3001
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/immotisse
FALLBACK_MONGODB_URI=mongodb://127.0.0.1:27017/immotisse
JWT_SECRET=your_jwt_secret_here

# Email configuration - GMAIL
# Pour Gmail: Utiliser un "App Password" (pas le mot de passe normal)
# 1. Activer "2-Step Verification" sur https://myaccount.google.com/security
# 2. Aller à https://myaccount.google.com/apppasswords
# 3. Générer un mot de passe pour "Mail" et "Windows Computer"
# 4. Copier le mot de passe généré dans SMTP_PASS
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-16-character-app-password

# Email configuration - SENDGRID (Alternative à Gmail)
# Pour SendGrid: Utiliser votre clé API
# SMTP_SERVICE=sendgrid
# SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Email configuration - SERVICE SMTP GÉNÉRIQUE
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_password

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional unsigned preset alternative
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Optional SendGrid settings
SENDGRID_API_KEY=SG.xxxxx
